{
  "family": "uob_transport_app_task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "3072",
  "executionRoleArn": "arn:aws:iam::361769585501:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "uob_transport_app",
      "image": "PLACEHOLDER", 
      "cpu": 0,
      "portMappings": [
        {
          "name": "uob_transport_app-3000-tcp",
          "containerPort": 3000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "AUTH_TRUST_HOST",
          "value": "true"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:361769585501:secret:database-url-iJfqvH"
        },
        {
          "name": "AUTH_SECRET",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:361769585501:secret:auth-secret-token-56Xo1O"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/uob_transport_app_task",
          "awslogs-create-group": "true",
          "awslogs-region": "eu-west-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}