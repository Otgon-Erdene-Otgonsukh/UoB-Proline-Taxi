{
  "family": "uob_transport_app_task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::361769585501:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::361769585501:role/ecs-ses-role",
  "containerDefinitions": [
    {
      "name": "uob_transport_app",
      "image": "PLACEHOLDER", 
      "cpu": 0,
      "portMappings": [
        {
          "name": "uob_transport_app-3000-tcp",
          "containerPort": 3000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "AUTH_TRUST_HOST",
          "value": "true"
        },
        {
          "name": "AWS_SES_REGION",
          "value": "eu-west-2"
        },
        {
          "name": "SES_FROM_EMAIL",
          "value": "mail@uobsustainabletransport.cretin.org"
        },
        {
          "name": "AUTH_URL",
          "value": "https://uobst.ilm.gg"
        },
        {
          "name": "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
          "value": "BDwMrZ26nHR946Cg-ETLDZXoQhlUApUHoWB4B4gW-ewFQdictEoOZu0bU3ukUwo8roc7AhVTmrYDaVsA2NhSn3w"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:361769585501:secret:database-url-iJfqvH:DATABASE_URL::"
        },
        {
          "name": "AUTH_SECRET",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:361769585501:secret:auth-secret-token-56Xo1O:AUTH_SECRET::"
        },
        {
          "name": "OSRM_SECRET",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:361769585501:secret:osrm_key-FhDb5J:OSRM_SECRET::"
        },
        {
          "name": "VAPID_PRIVATE_KEY",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:361769585501:secret:vapid_pub_key-opRcwS:VAPID_PRIVATE_KEY::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/uob_transport_app_task",
          "awslogs-create-group": "true",
          "awslogs-region": "eu-west-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
