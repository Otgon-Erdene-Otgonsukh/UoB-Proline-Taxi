generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id      Int           @id @default(autoincrement())
  dep_id       Int
  email        String        @unique @db.VarChar(255)
  password     String        @db.VarChar(255)
  name         String        @db.VarChar(100)
  phone_number String        @db.VarChar(20)
  time_created DateTime      @default(now()) @db.Timestamp(6)
  role         String        @db.VarChar(255)
  user_status  Int           @default(0)
  department   department   @relation(fields: [dep_id], references: [dep_id], onUpdate: NoAction)
  booking      booking[]

  @@index([dep_id], map: "idx_user_dep_id")
  @@index([role], map: "idx_user_role")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model booking {
  booking_id      Int       @id @default(autoincrement())
  user_id         Int
  trip_id         Int       @unique 
  booking_status  String    @default("Pending")
  time_created    DateTime  @default(now()) @db.Timestamp(6)
  passenger_name  String    @db.VarChar(255)
  tel_number      String    @db.VarChar(32)
  email           String    @db.VarChar(64)
  additional_info String?   @db.VarChar(255)
  trip            trip      @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade, onUpdate: NoAction)
  User            User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_booking_user_id")
}

model department {
  dep_id     Int    @id @default(autoincrement())
  dep_name   String @db.VarChar(100)
  manager_id Int?
  User       User[]
}

model trip {
  trip_id            Int        @id @default(autoincrement())
  icabbi_booking_id  Int?
  pickup_location    String     @db.VarChar(255)
  pickup_latitude    Int?
  pickup_longitude   Int?
  dropoff_location   String     @db.VarChar(255)
  dropoff_latitude   Int?
  dropoff_longitude  Int?
  pickup_time        DateTime   @db.Timestamp(6)
  via                String?    @db.VarChar(255)
  passenger_num      Int
  return_drop_loc    String?    @db.VarChar(255)
  PO                 String?    @db.Text
  airport            String?    @db.VarChar(255)
  flight_num         String?    @db.VarChar(32)
  return_pickup_time DateTime?  @db.Timestamp(6)
  booking            booking?
}

model user_reset {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @db.VarChar(64)
  expired_at DateTime @db.Timestamp(6)
  email      String   @unique @db.VarChar(255)
}
